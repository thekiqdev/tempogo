# Gerar quatro valores hexadecimais independentes de 32 bytes (64 caracteres).
# Somente homologação local. Nunca usar credenciais de desenvolvimento ou produção.
HOMOLOG_DB_PASSWORD=replace_with_64_hex_characters
HOMOLOG_RUNTIME_PASSWORD=replace_with_another_64_hex_characters

HOMOLOG_PLATFORM_PASSWORD=replace_with_independent_64_hex_characters
HOMOLOG_PLATFORM_MFA_KEY=replace_with_independent_64_hex_key
