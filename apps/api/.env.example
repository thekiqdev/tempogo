# Backend / API no Easypanel. Substitua todos os REPLACE antes do deploy.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
PUBLIC_ORIGIN=https://tempogo.example.com
# Role limitada, provisionada conforme doc/43-atualizacao-super-admin-deploy.md.
DATABASE_URL=postgresql://cronocheckpoint_runtime:REPLACE@PROJECT_database:5432/tempogo
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM="TempoGo <acesso@example.com>"
METRICS_TOKEN=REPLACE_WITH_RANDOM_64_HEX
# Para habilitar /plataforma, configure AMBAS as variáveis abaixo.
# Sem elas, o painel da plataforma permanece desabilitado.
# PLATFORM_DATABASE_URL=postgresql://cronocheckpoint_platform_runtime:REPLACE@PROJECT_database:5432/tempogo
# PLATFORM_MFA_KEY=REPLACE_WITH_RANDOM_64_HEX
# Gere a chave uma única vez e preserve entre deploys. Nunca use a chave local.
# MIGRATION_DATABASE_URL e senhas de provisionamento ficam apenas no job temporário.
