# Somente desenvolvimento local. Configure uma senha local antes de subir o banco.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql://cronocheckpoint:replace_with_local_password@127.0.0.1:55432/cronocheckpoint
TEST_DATABASE_URL=postgresql://cronocheckpoint:replace_with_local_password@127.0.0.1:55432/cronocheckpoint_test
API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development

# SMTP local (Mailpit)
PUBLIC_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=TempoGo <acesso@tempogo.local>

