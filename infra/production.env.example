# Configure in Easypanel. Never commit real values.
NODE_ENV=production
PUBLIC_ORIGIN=https://cronometro.example.com
API_HOST=0.0.0.0
API_PORT=3001
# Limited runtime role; private Postgres network only.
DATABASE_URL=postgresql://cronocheckpoint_runtime:REPLACE@PROJECT_database:5432/cronocheckpoint
# Only on temporary migration job, NEVER in API service:
# MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:REPLACE@PROJECT_database:5432/cronocheckpoint
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=TempoGo <acesso@example.com>
METRICS_TOKEN=REPLACE_WITH_RANDOM_64_HEX
# Only in WEB service. Use actual private DNS from Easypanel.
API_UPSTREAM=PROJECT_api:3001

# Super admin: runtime independente e chave MFA de 32 bytes hexadecimais
# PLATFORM_DATABASE_URL=postgresql://cronocheckpoint_platform_runtime:REPLACE@DATABASE:5432/DATABASE
# PLATFORM_MFA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
